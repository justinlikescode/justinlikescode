---
import { getImage } from "astro:assets";
import { getData } from "@lib/helpers";

import { ClientRouter } from 'astro:transitions';
import { Font } from "astro:assets";
import favicon from '@images/favicon.ico';

import "@css/main.css";

import Header from "@layouts/header.astro";
import Main from "@layouts/main.astro";
import Footer from "@layouts/footer.astro";


const strapiMetaImageData =  await getData('home-page', {
    populate: {
        introImage: {
            populate: "*",
        }
    }
}).then(r => r.json()).then(data => data.data.introImage)

const strapiMetaImageUrl = new URL(strapiMetaImageData.formats.large.url, import.meta.env.SECRET_API_URL)
const processedMetaImage = await getImage({ src: strapiMetaImageUrl.href, format: "jpg", inferSize: true })
const defaultMetaImage = new URL(processedMetaImage.src, Astro.url)

const { siteTitle = 'justin, a dev', metaPageDescription = "", metaPageType = "website", metaPageImageUrl = defaultMetaImage.href } = Astro.props

---
<script>
    /*
     * NOTE: this used to be a thing but utilizing a react Context 
     * gives better reactivity for theme mode.
        function loadTheme() {
            localStorage.getItem("theme") === "light" ? document.documentElement.classList.remove("dark") : document.documentElement.classList.add("dark")
        }
        document.addEventListener("astro:page-load", loadTheme);
    */

    function applyTheme(event: any) {
        event.newDocument.documentElement.dataset.theme = localStorage.getItem("theme")
    }

    // FIXED: this does not flash bang the user! the old "applyTheme"
    // code wasn't applying localStorage.theme to the *new* document 
    // it was adding it to the old one and *then* updating the new one
    document.addEventListener("astro:before-swap", applyTheme);
</script>

<script>
    import { annotate } from "rough-notation"

    function processAnchors(anchorArray: NodeListOf<HTMLElement>, anchorOptions: object = {}): void {
        anchorArray.forEach((anchor:HTMLElement) => {
            const passedOptions = anchor.dataset.annotateOptions
                ? JSON.parse(anchor.dataset.annotateOptions) 
                : {}
            const annotateOptions = Object.assign(anchorOptions, passedOptions)
            const annotation = annotate(anchor, annotateOptions)

            anchor.addEventListener('mouseover', (_event:MouseEvent) => {
                annotation.show()
            })

            anchor.addEventListener('mouseout', (_event:MouseEvent) => {
                annotation.hide()
            })
        })
    }

    document.addEventListener('astro:page-load', function () {
        const annotateGeneric = document.querySelectorAll('.annotateMe') as NodeListOf<HTMLElement>
        const annotateCircleAnchors = document.querySelectorAll('.annotateCircle') as NodeListOf<HTMLElement>
        const annotateUnderlineAnchors = document.querySelectorAll('.annotateUnderline') as NodeListOf<HTMLElement>

        processAnchors(annotateUnderlineAnchors, { type: 'underline' }) 
        processAnchors(annotateCircleAnchors, { type: 'circle' })
        processAnchors(annotateGeneric)
    })
</script>

<html lang="en" data-theme>
    <head>
        <meta charset="utf-8" />

        <link rel="icon" type="image/svg+xml" href={favicon} />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        {metaPageDescription != "" && <meta name="description" content={metaPageDescription} />}

        <meta property="og:title" content={siteTitle} />
        <meta property="og:type" content={metaPageType} />
        <meta property="og:url" content={Astro.url} />
        {metaPageImageUrl != "" && <meta property="og:image" content={metaPageImageUrl} />}

        <title>{siteTitle}</title>

        <Font cssVariable="--font-roboto-slab" />

        <ClientRouter />
    </head>
    <body>
        <span id="top"></span>
        <Header transition:persist />
        <Main>
            <slot />
        </Main>
        <Footer transition:persist />
    </body>
</html>
