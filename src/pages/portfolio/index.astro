---
export const prerender = true

import { getCollection } from 'astro:content';
import { capitalizeString, getCategoryIcon } from "@lib/helpers";

import BaseLayout from "@layouts/base.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import NerdFontIcon from "@components/buttons/NerdFontIcon.astro";

const projects = await getCollection('projects');


let sortedByCategory: any = []

projects.map((project: any) => {
    if (sortedByCategory.find((categoryItem: any) => {
        if (categoryItem.id === project.data.category) {
            categoryItem.count++
            categoryItem.projects = [...categoryItem.projects, project]
            return true
        } else {
            return false
        }
    })) {
        // technically above *is* what we did
    } else {
        sortedByCategory.push({
            id: project.data.category,
            count: 1,
            projects: [project]
        })
    }
})

const sortedByCount = await sortedByCategory.sort((a: any, b: any) => (a.count > b.count) ? -1 : 1)

const categoryTitle = (categoryId: string): string => {
    if(categoryId.includes('2')) {
        return categoryId.split('2').map(word => capitalizeString(word)).join('2')
    }

    if(!categoryId.includes('/')){ 
        return capitalizeString(categoryId)
    } 

    return categoryId.split('/').map(word => capitalizeString(word)).join('/')
}
---

<BaseLayout>
    <section class="container mx-auto">
        {sortedByCount.map(({id, projects}: {id:any, projects:any}) => 
        <div class="mb-24 first-of-type:mt-12 last-of-type:mb-8">
            <h2 class="text-4xl mb-8"><NerdFontIcon icon={getCategoryIcon(id)} /> {categoryTitle(id)}</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-15 gap-y-8">
                {projects.map((project: any) => <ProjectCard project={project}  />)}
            </div>
        </div>
        )}
    </section>
</BaseLayout>
