---
export const prerender = true

import { getCollection } from 'astro:content'
import { marked } from 'marked'

import { getTechStackIcon, getCategoryIcon } from "@lib/helpers";

import BaseLayout from "@layouts/base.astro"
import PillButton from '@components/buttons/PillButton.astro'
import NerdFontIcon from '@components/buttons/NerdFontIcon.astro'
import Slider from '@components/slider/Slider.astro'
import Slide from '@components/slider/Slide.astro'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
    const portfolioProjects = await getCollection('projects')

    const staticPaths = portfolioProjects.map(({...project}: any) => {
        return {
            params: { slug: project.data.slug },
            props:{...project.data}
        }
    })

    return staticPaths
}


const { title, show_url = true, url: external_url, screenshots, description, techStack, category, preview } = Astro.props

const screenshotsSortedWidest = screenshots.sort((a: any, b: any) => (a.width > b.width) ? 1 : -1).reverse()

type TechStackType = {
    id: number,
    frameworks: string
}

const stacks = techStack.filter((stack: TechStackType) => {
    if(stack.frameworks == null) return false
    return stack.frameworks
})

const swiperThumbs = {
    autoHeight: false,
    slidesPerView: 3,
    navigation: false,
    centeredSlides: true,
    centerInsufficientSlides: true,
    breakpoints: {
        411: {
            slidesPerView: 1,
        }
    }
}

const swiperOptions = {
    autoHeight: true,
    thumbs: {
        swiper: '.thumbnails-swiper'
    }
}

const API_URL = import.meta.env.SECRET_API_URL;
---
<BaseLayout>
    <section class="container mx-auto py-8 lg:py-16">
        <h2 class="text-primary dark:text-cyan pb-10">{title}</h2>

        <div class="flex flex-col lg:flex-row">
            <div class="flex flex-col w-full xl:w-2/3">
                <div class="project-slideshow">
                    <Slider class="main-swiper" swiperOptions={swiperOptions}>
                        <Fragment slot="slides">
                            {screenshotsSortedWidest.map((screenshot: any) => 
                            <Slide class="main-swiper-slide">
                                <Image
                                    src={API_URL + screenshot.url}
                                    inferSize={true}
                                    alt={screenshot.alternativeText ? screenshot.alternativeText : title}
                                    class="main-swiper-image"
                                    />
                            </Slide>
                            )}
                        </Fragment>
                    </Slider>
                </div>

                <div class="project-thumbnails">
                    <Slider class="thumbnails-swiper" arrows={false} swiperOptions={swiperThumbs}>
                        <Fragment slot="slides">
                            {screenshotsSortedWidest.map((screenshot: any) => 
                            <Slide class="thumbnails-swiper-slide">
                                <Image
                                    src={API_URL + screenshot.url}
                                    width="221"
                                    height="120"
                                    alt={screenshot.alternativeText ? screenshot.alternativeText : title}
                                    class="thumbnails-swiper-image"
                                    />
                            </Slide>
                            )}
                        </Fragment>
                    </Slider>
                </div>
            </div>

            <div class="w-full xl:w-1/3 lg:ml-10 mt-8 lg:mt-0 flex flex-col">
                <div class="flex flex-row justify-between items-start">
                    <div class="table-cell">
                        <h3 class="text-black dark:text-darker-200">Category:</h3>
                    </div>
                    <div class="table-cell pl-4 text-right">
                        <h3 class="text-primary dark:text-cyan items-center mb-6">
                            <NerdFontIcon icon={getCategoryIcon(category)} /> {category}
                        </h3>
                    </div>
                </div>
                {stacks.length > 0 &&
                <div class="flex flex-row justify-between items-start">
                    <div class="table-cell">
                        <h3 class="text-black dark:text-darker-200">Tech Stack:</h3>
                    </div>
                    <div class="table-cell pl-4 text-right">
                        {stacks.map(({frameworks:framework}: {frameworks: string}) =>
                        <h3 class="text-primary dark:text-cyan items-center mb-4 last-of-type:mb-0">
                            <NerdFontIcon icon={getTechStackIcon(framework)} /> {framework}
                        </h3>
                        )}
                    </div>
                </div>}
                <div class="flex flex-row justify-between items-start">
                    <div class="table-cell">
                        <h3 class="text-black dark:text-darker-200 pt-6">Summary:</h3>
                    </div>
                </div>
                <div>
                    <div class="project-summary py-6">
                        <Fragment set:html={marked.parse(preview)} />
                    </div>
                </div>
                {show_url &&
                <div class="flex flex-row items-center justify-center">
                    <div class="table-cell col-span-full">
                        <PillButton class="flex flex-row text-2xl justify-center items-center mt-8 mx-auto lg:mx-unset w-fit" href={external_url} target="_blank">
                            <NerdFontIcon icon="nf-md-web mr-2" />Visit Site
                        </PillButton>
                    </div>
                </div>
                }
            </div>
        </div>

        <div class="pt-8 project-description markdown-content">
            <Fragment set:html={marked.parse(description)} />
        </div>

    </section>
</BaseLayout>
