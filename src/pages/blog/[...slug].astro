---
/*
 * NOTE: the cool thing I'm seeing here is that
 * with astro its pretty easy to go between SSG
 * and SSR.
 *  
 * For now I'm going to stay with a build based 
 * deployment, I have a workflow with it and 
 * I want to keep that energy up.
 */
export const prerender = true

import { getCollection } from 'astro:content';
import { marked } from 'marked';

import { blogDate } from '@lib/helpers'
import BaseLayout from "@layouts/base.astro"

import ContentBlocks from "@components/blog/ContentBlocks.astro"

export async function getStaticPaths() {
    const blogPosts = await getCollection('blog');

    const paths = blogPosts.map(({...post}: any) => {
        if (post == null) return {}
        return {
            params: { slug: post.data.slug },
            props:{...post.data} 
        }
    })

    return paths
}

const { title, publishDate, content, blogContent } = Astro.props

// console.log(blogContent)
---
<BaseLayout>
    <article class="h-fit relative" itemscope itemtype="https://schema.org/BlogPosting">
        <section class="blog-post-title">
            <div class="container mx-auto relative z-50">
                <h2 class="text-purple-900 dark:text-purple-200 text-center pb-6" itemprop="headline">{title}</h2>
                <div class="author-and-date">
                    <p itemprop="author" itemscope itemtype="https://schema.org/Person" class="text-purple-900 dark:text-purple-200 mr-2"><em>written by</em> <span class="text-primary dark:text-green" itemprop="givenName">Justin</span> <span class="text-primary dark:text-green" itemprop="familyName">Paelmo</span></p>
                    <p class="text-purple-900 dark:text-purple-200">published <em itemprop="datePublished" class="text-primary dark:text-green">{blogDate(publishDate)}</em></p>
                </div>
            </div>
        </section>
        {blogContent == null && 
        <section class="markdown-content pt-12 z-10">
            <div class="justin-container mx-auto" itemprop="articleBody">
                <Fragment set:html={marked.parse(content)} />
            </div>
        </section>
        }
        {blogContent != null &&
        <section class="markdown-content pt-12 z-10">
            <div class="justin-container mx-auto" itemprop="articleBody">
                <ContentBlocks blocks={blogContent} />
            </div>
        </section>
        }
    </article>
</BaseLayout>

<style>
@reference "#main.css";

.blog-post-title {
    @apply px-8 py-6 grid-bg z-40 shadow-xl/5;
    @apply border-b border-primary dark:border-secondary;

    &:before {
        @apply opacity-85;
    }

    @variant lg {
        @apply top-0;
    }

    .author-and-date {
        @apply flex justify-between items-center mx-auto w-fit text-left;

        p + p {
            @apply py-0 my-0;
        }
    }
}

</style>
