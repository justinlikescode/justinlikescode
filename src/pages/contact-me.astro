---
import BaseLayout from "@layouts/base.astro"
import SectionHeader from "@components/pageSections/SectionHeader.astro"

import ContactForm from "@components/forms/Form.tsx"

const FORM_SUBMIT_URL = import.meta.env.SECRET_FORM_SUBMIT_URL;
const RECAPTCHA_SITE_KEY = import.meta.env.SECRET_RECAPTCHA_SITE_KEY;

const pageTitle = "Contact Me - justinlikescode"
const pageDescription = "A contact form to get in touch with justinlikescode."
---
<BaseLayout siteTitle={pageTitle} metaPageDescription={pageDescription}>
    <section class="container mx-auto max-w-2xl py-16">
        <SectionHeader class="mb-9">
            <h2 slot="title">Contact Me</h2>
        </SectionHeader>
        <ContactForm client:only="react" formUrl={FORM_SUBMIT_URL} recaptchaSiteKey={RECAPTCHA_SITE_KEY} />
    </section>
</BaseLayout>
