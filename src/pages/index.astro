---
import { Image } from "astro:assets"
import { getData } from "@lib/helpers";

import resume from "/justin-paelmo-resume.pdf"
import offlinePortfolio from "/justin-paelmo-offline-portfolio.pdf"
import me from "@images/me.jpeg"

import BaseLayout from "@layouts/base.astro"

import PillButton from "@components/PillButton.astro"

import Intro from "@components/Intro.astro"
import Services from "@components/services/Services.astro"
import SectionHeader from "@components/SectionHeader.astro"
import BlogPosts from "@components/blog/BlogPosts.astro"
import SocialMediaList from "@components/SocialMediaList.astro"

const englishLocalization =  await getData('home-page?populate=buttons&populate=introImage').then(r => r.json()).then(data => data.data)
---

<script is:inline type="module">
import { createTimeline } from 'https://esm.sh/animejs';

document.addEventListener('astro:page-load', () => {
    const timeline = createTimeline({
            defaults: { duration: 500 }
    })

    timeline
        .add('.portrait-image-image', {
            x: ["-100%", 0]
        })
        .add('.portrait-image-underlay', {
            height: [0, "100%"]
        })
})
</script>

<BaseLayout>
    <Intro data={englishLocalization} />

    <Services />

    <section id="resume" class="bg-primary dark:bg-darker-900 py-14">
        <SectionHeader class="mb-4">
            <h2 class="text-white dark:text-cyan" slot="title">See My Work</h2>
        </SectionHeader>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 max-w-fit mx-auto">
            <PillButton href={`/portfolio`} class="inverse mx-auto text-3xl border-white after:bg-white! hover:text-primary dark:hover:text-secondary mb-8 md:mb-0" target="_blank">
                Online Portfolio
            </PillButton>
            <PillButton href={offlinePortfolio} class="inverse mx-auto text-3xl border-white after:bg-white! hover:text-primary dark:hover:text-secondary" target="_blank">
                Download a PDF
            </PillButton>
        </div>
    </section>


    <BlogPosts />

    <section id="social" class="bg-primary dark:bg-darker-900 pt-8"> 
        <SectionHeader class="mb-4">
            <h2 class="text-white dark:text-cyan" slot="title">Social Media</h2>
        </SectionHeader>
        <div class="justin-container flex flex-col items-center justify-center">
            <SocialMediaList />
        </div>
    </section>

</BaseLayout>
