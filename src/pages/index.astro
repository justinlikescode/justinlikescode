---
import { getData } from "@lib/helpers";

import BaseLayout from "@layouts/base.astro"

import Intro from "@components/pageSections/Intro.astro"

import Services from "@components/services/Services.astro"
import BlogPosts from "@components/blog/BlogPosts.astro"
import SeeMyWork from "@components/pageSections/SeeMyWork.astro"
import SocialMedia from "@components/pageSections/SocialMedia.astro"

const homePageFields = {
    populate: {
        buttons: {
            populate: "*",
        },
        introImage: {
            populate: "*",
        },
    }
}

const englishLocalization =  await getData('home-page', homePageFields).then(r => r.json()).then(data => data.data)
---


<BaseLayout>
    <Intro data={englishLocalization} />

    <Services />

    <SeeMyWork />

    <BlogPosts />

    <SocialMedia />

</BaseLayout>
