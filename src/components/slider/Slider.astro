---
import NerdFontIcon from '@components/buttons/NerdFontIcon.astro'

import 'swiper/css/bundle' // @ts-nocheck

const { class:classList = "", swiperOptions = {}, arrows = true } = Astro.props

const swiperDefaults = {
    navigation: {
        enabled: arrows,
        nextEl: '.justin-next',
        prevEl: '.justin-prev',
    }
}
const swiperConfig = { ...swiperDefaults, ...swiperOptions }
---

<div
    class={`swiper relative ${classList}`}
    x-data
    x-swiper.thumbs=`${JSON.stringify(swiperConfig)}`>
    <div class="swiper-wrapper relative">
        <slot name="slides"></slot>
    </div>
    {arrows &&
    <slot name="arrows">
        <div class="relative flex flex-row w-full justify-center -mt-4 -translate-y-full z-60">
            <div class="justin-prev">
                <NerdFontIcon icon="nf-fa-circle_chevron_left" class="text-4xl" />
            </div>
            <div class="justin-next">
                <NerdFontIcon icon="nf-fa-circle_chevron_right" class="text-4xl" />
            </div>
        </div>
    </slot>}
</div>
