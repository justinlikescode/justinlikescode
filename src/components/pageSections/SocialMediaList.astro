---
import NerdFontIcon from '@components/buttons/NerdFontIcon.astro'

export type SocialMedia = {
    label: string,
    url: string,
    icon: string,
    classes: string
}

export const socialMedia: SocialMedia[] = [
    {
        label: 'github',
        url: 'https://github.com/thatONEjustin',
        icon: 'nf-dev-github',
        classes: 'text-white'
    },
    {
        label: 'linkedin',
        url: 'https://www.linkedin.com/in/justinlikescode/',
        icon: 'nf-md-linkedin',
        classes: 'text-white'
    },
]
---

<ul class="flex flex-row">
    {socialMedia.map(({ url, classes, icon, label }: SocialMedia) =>
    <li class="mr-4 last:mr-0 text-4xl transition-transform hover:scale-125">
        <a href={url} target="_blank" class="no-underline">
            <NerdFontIcon icon={icon} class={classes} />
            <span class="sr-only">{label}</span>
        </a>
    </li>
    )}
</ul>
