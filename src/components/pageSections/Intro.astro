---
import { Image } from "astro:assets"
import { marked } from 'marked'

import PillButton from "@components/buttons/PillButton.astro"

const { introImage, Content:introText, Greeting:greetingText, buttons } = Astro.props.data

const API_URL = import.meta.env.SECRET_API_URL;
const me = API_URL + introImage.formats.large.url
---
<script is:inline data-astro-rerun type="module">
import { createTimeline, splitText, stagger, animate, engine, utils } from 'https://esm.sh/animejs';

engine.defaults.autoplay = false

const imagePortrait = animate('.portrait-image-image', {
    x: {
        from: "-100%",
        to: 0,
    },
    onBegin: () => utils.$('.portrait-image')[0].classList.remove('opacity-0'),
    duration: 350
})

const imageUnderlay = animate('.portrait-image-underlay', {
    height: {
        from: 0,
        to: "100%",
    },
    duration: 350
})


const introHeaderSplit  = splitText('h2.intro-text', { words: true })
const { words: introHeaderWords } = introHeaderSplit

const introTextSplit = splitText('.intro-textContent', { words: true })
const { words: introTextWords } = introTextSplit

const introHeaderAnimation = animate(introHeaderWords, {
    opacity: {
        from: 0,
        to: 1,
    },
    y: {
        from: "-100%",
        to: 0,
    },
    delay: stagger(100),
    duration: 150,
    onBegin: () => utils.$('.intro')[0].classList.remove('opacity-0'),
    onComplete:() => introHeaderSplit.revert()
})

const introTextAnimation = animate(introTextWords, {
    opacity: {
        from: 0,
        to: 1,
    },
    y: {
        from: "-100%",
        to: 0,
    },
    delay: stagger(25),
    duration: 50,
    onComplete:() => introTextSplit.revert()
})

const introButtonAnimation = animate('.intro .pill-button', {
    scaleY: {
        from: 0,
        to: 1,
    },

    onBegin: () => utils.$('.intro .pill-button').forEach(button => button.classList.remove('opacity-0')),
    delay: stagger(25),
    duration: 150
}).init()

const imageTimeline = createTimeline({
    defaults: { duration: 350 }
})
    .sync(imagePortrait)
    .sync(imageUnderlay)

const textTimeline = createTimeline({
    defaults: { duration: 150 }
})
    .sync(introHeaderAnimation)
    .sync(introTextAnimation)
    .sync(introButtonAnimation)

const mainTimeline = createTimeline()
    .sync(imageTimeline)
    .sync(textTimeline, '-=700')

mainTimeline.play()
</script>

<section class="home-hero">
    <div class="home-hero-container py-8 md:py-0 z-20! overflow-hidden px-4 xl:px-0">
        <div class="desktop-portrait">
            <div class="portrait-image opacity-0">
                <Image
                    src={me}
                    inferSize={true}
                    alt={greetingText}
                    class="portrait-image-image"
                    fetchpriority="high"
                    />

                <div class="portrait-image-underlay"></div>
            </div>
        </div>

        <div class="intro opacity-0">
            <h2 class="text-center md:text-left pb-4 intro-text">{greetingText}</h2>

            <div class="mobile-portrait">
                <Image fetchpriority="high" loading="lazy" src={me} inferSize={true} alt={greetingText} />
            </div>

            <div class="intro-textContent">
                <Fragment set:html={marked.parse(introText)} />
            </div>

            {buttons.length && buttons.map((button: any) => <PillButton class="opacity-0 flex flex-row text-2xl justify-center items-center mt-8 mx-auto lg:mx-unset" href={button.URL}>{button.Label}</PillButton>)}
        </div>
    </div>
</section>

