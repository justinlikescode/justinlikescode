---
import { Image } from "astro:assets"
import { truncateWords } from '@shahid19/stringjs'

import NerdFontIcon from '@components/buttons/NerdFontIcon.astro'

const { icon = "", category = "" } = Astro.props
const { ...data } = Astro.props.project.data

const { title, slug, preview, screenshots } = data

const previewImage = screenshots.sort((a: any, b: any) => (a.width < b.width) ? 1 : -1)

const API_URL = import.meta.env.SECRET_API_URL;
const screenshotUrl = API_URL + previewImage[0].formats.medium.url

const projectUrl = `/portfolio/${category}/${slug}`
---
<div class="project-card">
    {screenshotUrl &&
    <div class="project-card-image annotateMe" data-annotate-options={`{ "type": "bracket", "color": "var(--color-secondary)", "brackets": [ "left", "right" ] }`}>
        <a href={projectUrl}>
            <Image
                src={screenshotUrl}
                inferSize={true}
                class="object-cover w-full h-full rounded-lg border border-primary dark:border-secondary"
                alt={preview} />
        </a>
    </div>}
    <div class="mt-8">
        <a href={projectUrl}>
            <h3 class="text-primary dark:text-cyan">
                <span class="annotateUnderline">
                    {icon != '' && <NerdFontIcon icon={icon} class="text-primary dark:text-cyan mr-2" />}
                    {title}
                </span>
            </h3>
        </a>
        <p class="text-xl pt-4 pb-8.5 leading-[150%]">{truncateWords(preview, 30)}</p>

    </div>

    <a href={projectUrl} class="learn-more text-secondary">
        <span class="text-secondary annotateUnderline">
            Learn More
        </span>
    </a>
</div>
<style>
@reference "#main.css";
.project-card {
    @apply relative flex flex-col;
}
.project-card-image {
    @apply h-68.5 w-full relative mb-3;
    @apply rounded-lg;

    &:after {
        content: ' ';
        @apply absolute w-full h-full top-3 left-3 -z-10 pointer-events-none;
        @apply transition-colors;
        @apply bg-primary;
        @apply rounded-lg;

        @variant dark {
            @apply bg-secondary;
        }
    }
}

@variant dark {
    .project-card-image {
        &:after {
            @apply bg-secondary!;
        }
    }
}

.learn-more {
    @apply justify-self-end relative font-bold mt-auto w-fit;

    /* &:after { */
    /*     content: ' '; */
    /*     @apply absolute w-full h-0.5 transition-all; */
    /*     @apply left-0 bottom-0; */
    /*     @apply bg-secondary; */
    /* } */

    @variant dark { 
        &:after {
            /* @apply bg-cyan; */
        }
    }
}
</style>
