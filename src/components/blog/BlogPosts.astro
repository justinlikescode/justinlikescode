---
export const prerender = true
import { getCollection } from 'astro:content'

import SectionHeader from '@components/pageSections/SectionHeader.astro'
import RecentBlogPost from './RecentBlogPost.astro'

const blogPosts = await getCollection('blog')

const latestBlogPosts = blogPosts
    .sort((a, b) => (a.data.publishedAt < b.data.publishedAt) ? 1 : -1)
    .slice(0,3)
---
<script>
import { animate, engine, stagger, createTimeline } from 'animejs';

engine.defaults.autoplay = false

const blogPosts = animate('#blogPosts .recent-blog-post', {
    opacity: [0, 1], // opacity is not working
    translateY: ['50%', '0%'],
    duration: 350,
    delay: stagger(150),
})

const mainTimeline = createTimeline({
    defaults: { duration: 350, }
})
    .sync(blogPosts)

const observerOptions = {
    root: document,
    threshold: 0.60,
}

const observer = new IntersectionObserver((entries, _observer) => {
    if (entries[0].isIntersecting) {
        mainTimeline.play()
    }
}, observerOptions)

const section = document.querySelector("#blogPosts")

if(section != null) {
    observer.observe(section)
}
</script>
<section id="blogPosts" class="blog-posts">
    <SectionHeader>
        <h2 slot="title">Blog</h2>
        <p slot="description">A mix of tutorials, musings, rants, and opinions about web development</p>
    </SectionHeader>
    <div class="blog-posts-container grid grid-cols-1 lg:grid-cols-3 gap-x-16">
        {latestBlogPosts.map((post: any) => <RecentBlogPost {...post} />)}
    </div>
</section>

<style>
@reference "#main.css";

.blog-posts {
    @apply py-10;
    @apply relative;

    .blog-posts-container {
        @apply relative mx-auto z-30;
        @apply px-8;

        @variant xl {
            @apply container px-0;
        }
    }
}
</style>
