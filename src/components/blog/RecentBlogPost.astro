---
import { blogDate } from '@lib/helpers'
import { truncateWords } from '@shahid19/stringjs'
const { data } = Astro.props

const { slug, Date:publishDate, Title:title, Preview:preview } = data

const blogUrl = new URL(`/blog/${slug}`, Astro.url)
---

{/*
<article 
    class="w-full recent-blog-post annotateMe"
    data-annotate-options={`{ 
        "type": "bracket",
        "color": "var(--color-secondary)", 
        "brackets": [ "right" ] 
    }`}>
 */}
<article class="recent-blog-post h-full">
    <h3 class="title annotateUnderline">
        <a href={blogUrl} set:html={truncateWords(title, 20)}></a>
    </h3>
    <div class="recent-blog-post-text">
        <h4 class="date"><em>{blogDate(publishDate)}</em></h4>
        <a href={blogUrl}>
            <p class="preview" set:html={preview}></p>
        </a>
    </div>
    {/* <a href={blogUrl} class="read-more mt-auto">
        <span class=" annotateUnderline">
            Read More
        </span>
    </a> */}
</article>

<style>
@reference "#main.css";

.recent-blog-post {
    @apply relative border-l-4 border-primary dark:border-secondary p-5 mb-10 last-of-type:mb-0 transition-all;

    /* 
    @variant hover {
        @apply scale-105;
    }

    &:after {
        @apply absolute w-64 h-128 top-1/2 -translate-y-1/2 translate-x-[100vw];
        @apply transition-all ease-in-out duration-500;
        @apply bg-linear-to-r from-transparent via-white/10 to-transparent;
        @apply blur-lg;
        @apply rotate-33;
        content: ' ';
    }

    @variant hover {
        @apply scale-105;

        &:after {
            @apply -translate-x-[400%];
        }
    } */

    .title {
        @apply w-full pb-0 mb-0;
        @apply text-3xl text-black dark:text-cyan;
    }

    .date {
        @apply text-black dark:text-cyan py-3 font-light;
    }

    .preview {
        @apply text-black dark:text-darker-300 font-light;
    }
}
</style>

