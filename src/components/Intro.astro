---
import { Image } from "astro:assets"
import { getData } from "@lib/helpers"
import { marked } from 'marked'

import PillButton from "@components/PillButton.astro"

const { introImage, Content:introText, Greeting:greetingText, buttons } = Astro.props.data

const API_URL = import.meta.env.SECRET_API_URL;
const me = API_URL + introImage.formats.large.url
---

<section class="home-hero">
    <div class="home-hero-container py-8 md:py-0 z-20! overflow-hidden">
        <div class="desktop-portrait">
            <div class="portrait-image">
                <Image
                    src={me}
                    inferSize={true}
                    alt={greetingText}
                    class="portrait-image-image"
                    />

                <div class="portrait-image-underlay"></div>
            </div>
        </div>

        <div class="intro">
            <h2 class="text-center md:text-left pb-4">{greetingText}</h2>

            <div class="mobile-portrait">
                <Image src={me} inferSize={true} alt={greetingText} class=""/>
            </div>

            <Fragment set:html={marked.parse(introText)} />

            {buttons.length && buttons.map((button: any) => <PillButton class="flex flex-row text-2xl justify-center items-center mt-8 mx-auto lg:mx-unset" href={button.URL}>{button.Label}</PillButton>)}
        </div>
    </div>
</section>

