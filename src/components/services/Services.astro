---
import SectionHeader from "@components/pageSections/SectionHeader.astro";
import ServiceCard from "./ServiceCard.astro";

const servicesData = [
    {
        title: "Web Development",
        description: "I’ve built websites for over 17 years! I’ve handled everything from eCommerce to blogging to credit unions and more. I have experience in a wide array of web technologies as a full stack developer.",
        buttonText: "Get In Touch",
        href: "/contact-me",
        icon: "nf-md-web_check"
    },
    {
        title: "IT/Networking",
        description: "Need help managing your local network? Having trouble understanding what hardware to purchase and why? I regularly keep my finger on the pulse on the latest technology trends and am here to help!",
        buttonText: "Get In Touch",
        href: "/contact-me",
        icon: "nf-fa-network_wired"
    },
    {
        title: "Custom Solutions",
        description: "Need something tech related that does not fall under the other two categories? Maybe you’re looking to learn more about the industries I’ve worked with/in. Let’s have a discussion I’m always glad to help people get the most out of technology!",
        buttonText: "Get In Touch",
        href: "/contact-me",
        icon: "nf-md-folder_question"
    }
]
---

{/**/}
<script>
import { animate, engine, splitText, stagger, spring, createTimeline } from 'animejs';

engine.defaults.autoplay = false

const sectionHeader = animate("#services > .section-header > h2", {
    opacity: [0, 1],
    translateY: ["-100%", 0],
    duration: 250
})

const { words: sectionTagline } = splitText('#services > .section-header > .description p', { words: true })

const sectionTaglineAnimation = animate(sectionTagline, {
    opacity: [0, 1],
    y: ['-100%', '0%'],
    delay: stagger(25),
    duration: 50,
})

const sectionTaglineHighlight = animate('#services > .section-header > .section-highlight', {
    width: ['0%', '200px'],
    ease: spring({
        bounce: 0.4,
        duration: 250
    }),
})

const textTimeline = createTimeline()
    .sync(sectionHeader)
    .sync(sectionTaglineAnimation)
    .sync(sectionTaglineHighlight)

const sectionServicesCards = animate('#services .service-card-container', {
    opacity: [0, 1], // opacity is not working
    translateY: ['50%', '0%'],
    duration: 350,
    delay: stagger(50),
})

const mainTimeline = createTimeline({
    defaults: { duration: 450 }
})
    .sync(textTimeline)
    .sync(sectionServicesCards)

const observerOptions = {
    root: document,
    threshold: 0.75,
}

const observer = new IntersectionObserver((entries, _observer) => {
    if (entries[0].isIntersecting) {
        console.log("In View")
        mainTimeline.play()
    }
}, observerOptions)

const services = document.querySelector("#services")

if(services != null) {
    observer.observe(services)
}
</script>
 

<section id="services" class="services-section py-20 flex flex-col items-center">
    <SectionHeader>
        <h2 slot="title">Services</h2>
        <p slot="description">I'm a big enthusiast (aka a big nerd) about web development, productive tooling, Continuous Integration/Development, and server administration.</p>
    </SectionHeader>

    <div class="service-cards container mx-auto py-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-x-10 xl:gap-x-30">
        {servicesData.map((serviceData: any) => <ServiceCard data={serviceData} />)}
    </div>
</section>
