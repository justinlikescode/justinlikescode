---
import NerdFontIcon from '@components/buttons/NerdFontIcon.astro'

const { data } = Astro.props
const { icon, title, description, href, buttonText } = data
---
<div class="service-card-container">
    <div class="service-card bg-offWhite">
        <div class="service-card-text pb-11">
            <h3 class="text-primary dark:text-cyan text-[32px]">
                <NerdFontIcon icon={icon} class="text-primary dark:text-cyan mr-2" />
                {title}
            </h3>
            <p class="text-xl pt-8.5 leading-[150%]">{description}</p>
        </div>

        <a href={href} class="learn-more">
            <span class="text-secondary dark:text-cyan annotateUnderline">
                {buttonText}
            </span>
        </a>

    </div>

    <div class="service-underlay"></div>
</div>
